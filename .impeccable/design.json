  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The lime Messenger call to action; the only filled button.",
      "html": "<div class=\"ds-dark\"><a class=\"ds-btn ds-btn-primary\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M12 2.2C6.4 2.2 2 6.3 2 11.6c0 2.8 1.2 5.2 3.2 6.9v3.3l3-1.7c1.2.3 2.4.5 3.8.5 5.6 0 10-4.1 10-9.4S17.6 2.2 12 2.2Zm1 12.6-2.6-2.7-4.9 2.7 5.4-5.7 2.6 2.7 4.8-2.7-5.3 5.7Z\"/></svg>Message for a free estimate</a></div>",
      "css": ":root{--ground:#12261d;--ground-2:#183326;--lime:#6fd43f;--lime-hi:#8be35f;--lime-ink:#0c1f12;--paper:#f1efe6;--paper-2:#e6e3d6;--ink:#13241c;--ink-soft:#43574b;--on-dark:#f4f6f1;--on-dark-soft:#b8cbbd;--leaf-green:#2f7a1f;--radius:14px;--shadow:0 10px 28px -12px rgba(6,20,12,.55);--font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}.ds-dark{background:#12261d;padding:24px}.ds-btn{font-family:var(--font,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 22px;border-radius:999px;font-weight:800;font-size:17px;line-height:1.1;text-decoration:none;border:2px solid #6fd43f;cursor:pointer;transition:transform .18s cubic-bezier(.2,.9,.3,1),background-color .18s}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:3px solid #6fd43f;outline-offset:3px}.ds-btn-primary{background:#6fd43f;color:#0c1f12;box-shadow:0 10px 22px -12px rgba(4,14,8,.7)}.ds-btn-primary:hover{background:#8be35f;transform:translateY(-2px)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Lime-outlined pill on the green ground; leaf-green border and ink text on paper.",
      "html": "<div class=\"ds-dark\"><a class=\"ds-btn ds-btn-secondary\" href=\"#\">What we take</a></div><div class=\"ds-paper\"><button class=\"ds-btn ds-btn-secondary ds-on-paper\">Copy message</button></div>",
      "css": ":root{--ground:#12261d;--ground-2:#183326;--lime:#6fd43f;--lime-hi:#8be35f;--lime-ink:#0c1f12;--paper:#f1efe6;--paper-2:#e6e3d6;--ink:#13241c;--ink-soft:#43574b;--on-dark:#f4f6f1;--on-dark-soft:#b8cbbd;--leaf-green:#2f7a1f;--radius:14px;--shadow:0 10px 28px -12px rgba(6,20,12,.55);--font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}.ds-dark{background:#12261d;padding:24px}.ds-paper{background:#f1efe6;padding:24px}.ds-btn{font-family:var(--font,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 22px;border-radius:999px;font-weight:800;font-size:17px;line-height:1.1;text-decoration:none;border:2px solid #6fd43f;cursor:pointer;transition:transform .18s cubic-bezier(.2,.9,.3,1),background-color .18s}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:3px solid #6fd43f;outline-offset:3px}.ds-btn-secondary{background:transparent;color:#f4f6f1}.ds-btn-secondary:hover{background:rgba(111,212,63,.12);transform:translateY(-2px)}.ds-on-paper{color:#13241c;border-color:#2f7a1f}.ds-on-paper:focus-visible{outline-color:#2f7a1f}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill toggle over a hidden checkbox or radio in the quote builder.",
      "html": "<div class=\"ds-wrap\"><label class=\"ds-chip\"><input type=\"checkbox\" checked><span>Furniture</span></label><label class=\"ds-chip\"><input type=\"checkbox\"><span>Yard debris</span></label><label class=\"ds-chip\"><input type=\"checkbox\"><span>Not sure</span></label></div>",
      "css": ".ds-wrap{background:#fff;padding:20px;display:flex;flex-wrap:wrap;gap:8px}.ds-chip{position:relative}.ds-chip input{position:absolute;opacity:0;width:1px;height:1px}.ds-chip span{font-family:var(--font,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:999px;border:2px solid #e6e3d6;background:#f1efe6;color:#13241c;font-weight:700;font-size:15px;cursor:pointer;transition:background-color .15s,border-color .15s,transform .15s}.ds-chip input:checked+span{background:#13241c;border-color:#13241c;color:#f1efe6}.ds-chip input:focus-visible+span{outline:3px solid #2f7a1f;outline-offset:2px}.ds-chip span:active{transform:scale(.96)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Quote builder field: paper fill, leaf-green border and white fill on focus.",
      "html": "<div class=\"ds-wrap\"><label class=\"ds-label\" for=\"ds-town\">Town</label><input class=\"ds-input\" id=\"ds-town\" placeholder=\"e.g. Edison\"></div>",
      "css": ".ds-wrap{background:#fff;padding:20px}.ds-label{font-family:var(--font,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);display:block;font-weight:800;font-size:15px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:10px;color:#13241c}.ds-input{font-family:var(--font,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);width:100%;box-sizing:border-box;min-height:52px;border-radius:12px;border:2px solid #e6e3d6;background:#f1efe6;padding:0 14px;font-size:17px;font-weight:500;color:#13241c}.ds-input::placeholder{color:#56645a}.ds-input:focus{outline:none;border-color:#2f7a1f;background:#fff}"
    },
    {
      "name": "Service Row",
      "kind": "custom",
      "refersTo": "service-row",
      "description": "Ruled list row: heavy uppercase service, sentence-case sub-line, ink arrow circle.",
      "html": "<ul class=\"ds-services\"><li><a href=\"#\"><span class=\"ds-svc\">Furniture<small>Couches, chairs, dressers.</small></span><span class=\"ds-go\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 12h13M13 6l6 6-6 6\"/></svg></span></a></li><li><a href=\"#\"><span class=\"ds-svc\">Yard debris<small>Branches, brush, bagged leaves.</small></span><span class=\"ds-go\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 12h13M13 6l6 6-6 6\"/></svg></span></a></li></ul>",
      "css": ".ds-services{list-style:none;margin:0;padding:0 20px;background:#f1efe6;border-top:2px solid #13241c}.ds-services li{border-bottom:2px solid #13241c}.ds-services a{display:flex;align-items:center;gap:14px;min-height:68px;padding:12px 2px;text-decoration:none;color:#13241c;transition:background-color .25s}.ds-svc{font-family:var(--font,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);flex:1;font-weight:900;text-transform:uppercase;font-size:24px;letter-spacing:-.01em;line-height:1.05;transition:transform .25s cubic-bezier(.2,.9,.3,1)}.ds-svc small{display:block;font-weight:500;text-transform:none;letter-spacing:0;font-size:15px;color:#43574b;margin-top:4px;line-height:1.35}.ds-go{width:40px;height:40px;flex:none;border-radius:50%;background:#13241c;color:#f1efe6;display:grid;place-items:center;transition:transform .25s cubic-bezier(.2,.9,.3,1),background-color .25s}.ds-services a:hover{background:#e6e3d6}.ds-services a:hover .ds-svc{transform:translateX(10px)}.ds-services a:hover .ds-go{transform:translateX(-6px);background:#2f7a1f}.ds-services a:focus-visible{outline:3px solid #2f7a1f;outline-offset:3px}"
    },
    {
      "name": "Quote Card",
      "kind": "card",
      "refersTo": "quote-card",
      "description": "White panel on paper holding the message builder; chat-bubble preview inside.",
      "html": "<div class=\"ds-paper\"><div class=\"ds-quote\"><h3>Ask for a free estimate</h3><p class=\"ds-sub\">Takes about 30 seconds.</p><p class=\"ds-plabel\">Your message</p><output class=\"ds-preview\">Hi Premier Outdoor Solutions! I'd like a free estimate for furniture. I'll send a photo in the chat.</output></div></div>",
      "css": ".ds-paper{background:#f1efe6;padding:24px}.ds-quote{font-family:var(--font,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);background:#fff;border-radius:22px;padding:22px 18px;box-shadow:0 18px 40px -20px rgba(19,36,28,.45);color:#13241c}.ds-quote h3{margin:0;font-weight:900;text-transform:uppercase;letter-spacing:-.02em;line-height:.95;font-size:30px}.ds-sub{margin:8px 0 0;color:#43574b;font-size:16px}.ds-plabel{margin:20px 0 0;font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#43574b}.ds-preview{display:block;margin-top:8px;background:#f1efe6;border-radius:14px 14px 14px 4px;padding:14px 16px;font-size:15px;line-height:1.45}"
    },
    {
      "name": "Heavy-Lifting Callout",
      "kind": "card",
      "refersTo": "heavy-callout",
      "description": "Ink block with lime icon under the service list.",
      "html": "<div class=\"ds-paper\"><div class=\"ds-heavy\"><svg viewBox=\"0 0 48 48\" width=\"44\" height=\"44\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M12 22h24l-3 18H15z\" opacity=\".35\"/><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10 22h28l-3.4 18H13.4zM17 22c0-5 3-9 7-9s7 4 7 9M24 6v3\"/></svg><div><b>Heavy lifting included</b><span>We carry it out. You point.</span></div></div></div>",
      "css": ":root{--ground:#12261d;--ground-2:#183326;--lime:#6fd43f;--lime-hi:#8be35f;--lime-ink:#0c1f12;--paper:#f1efe6;--paper-2:#e6e3d6;--ink:#13241c;--ink-soft:#43574b;--on-dark:#f4f6f1;--on-dark-soft:#b8cbbd;--leaf-green:#2f7a1f;--radius:14px;--shadow:0 10px 28px -12px rgba(6,20,12,.55);--font:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif}.ds-paper{background:#f1efe6;padding:24px}.ds-heavy{font-family:var(--font,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif);display:flex;gap:14px;align-items:center;background:#13241c;color:#f1efe6;border-radius:14px;padding:16px 18px;box-shadow:var(--shadow)}.ds-heavy svg{flex:none;color:#6fd43f}.ds-heavy b{display:block;text-transform:uppercase;font-weight:900;font-size:19px;letter-spacing:-.01em}.ds-heavy span{font-size:15px;color:#b8cbbd}"
    },
    {
      "name": "Seam",
